
{
  "$schema": "https://opencode.ai/config.json",

  // Limit the amount of tool output retained in model context.
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },

  // Compact older conversation context automatically.
  "compaction": {
    "auto": true,
    "background": false,
    "keep": {
      "tokens": 10000
    },
    "buffer": "20%"
  },

  // Ignore generated directories for filesystem watching.
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/coverage/**",
      "**/.git/**",
      "**/.cache/**",
      "**/tmp/**",
      "**/temp/**"
    ]
  },

  // Prevent normal file-reading and editing tools from
  // accessing dependencies and generated artifacts.
  "permissions": [
    {
      "action": "read",
      "resource": "**/node_modules/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "node_modules/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.venv/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".venv/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/venv/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "venv/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/node_modules/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "node_modules/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.venv/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".venv/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/venv/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "venv/**",
      "effect": "deny"
    }
  ],

  // Resize oversized images before sending them to models.
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1600,
      "max_height": 1600,
      "max_base64_bytes": 2097152
    }
  }
}
