[TEMPLATE]
# Example environment variables (copy to .env)
APP_ENV=development
# SECRET_KEY must be set to a strong, unique value in production.
# In development, a fallback secret is used when this is unset.
# SECRET_KEY=change-me-in-production
# DATABASE_URL=postgresql://user:pass@localhost:5432/halgheh
# Notification retention period in days (must be greater than zero).
NOTIFICATION_RETENTION_DAYS=90

# --- AI provider (application-wide defaults) ---
# Administrators may change these. No real secret is committed here.
# Provider identifier used by the default configuration.
AI_DEFAULT_PROVIDER=zai
# Default model identifier (Z.ai GLM-4.5).
AI_DEFAULT_MODEL=glm-4.5
# API key for the shared default provider. Leave empty to disable the default.
AI_DEFAULT_API_KEY=
# Provider endpoint. Configure this for your Z.ai subscription; it is never
# hardcoded. Example placeholder: https://api.z.ai/api/paas/v4
AI_DEFAULT_BASE_URL=
# Optional provider-specific configuration as a JSON object.
AI_DEFAULT_EXTRA_CONFIG=
# Server-side secret used to encrypt personal AI credentials at rest. Set a
# strong, unique value in production (falls back to SECRET_KEY if unset).
AI_CREDENTIAL_ENCRYPTION_KEY=

# --- AI agent execution limits (optional; safe defaults apply) ---
AGENT_MAX_TOOL_CALLS_PER_TURN=8
AGENT_MAX_CONTEXT_MESSAGES=40
AGENT_PROVIDER_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_ARGUMENT_BYTES=10000
AGENT_MAX_TOOL_RESULT_BYTES=50000
AGENT_PENDING_ACTION_TTL_SECONDS=900
# Require confirmation for event creation / ordinary updates (destructive
# Calendar actions always require confirmation).
AGENT_CONFIRM_CREATE_EVENT=false
AGENT_CONFIRM_UPDATE_EVENT=false
